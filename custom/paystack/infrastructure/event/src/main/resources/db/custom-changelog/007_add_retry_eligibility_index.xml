<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <changeSet author="paystack" id="007_add_retry_eligibility_index">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="ps_hook_event_record"/>
            <not>
                <indexExists indexName="idx_ps_hook_event_record_retry_eligibility" tableName="ps_hook_event_record"/>
            </not>
        </preConditions>
        <comment>Add composite index to optimize retry eligibility query performance</comment>

        <!-- Composite index for retry eligibility query optimization -->
        <!-- This index supports the findEligibleForRetry query which filters by:
             status, retry_count < max_retries, and COALESCE(last_retry_at, created_at) <= cutoff_time

             Index order is optimized for the query:
             1. status - most selective filter (typically PENDING)
             2. retry_count - used in retry_count < max_retries comparison
             3. last_retry_at - used in COALESCE(last_retry_at, created_at) <= cutoff_time
             4. created_at - fallback in COALESCE when last_retry_at IS NULL -->
        <createIndex indexName="idx_ps_hook_event_record_retry_eligibility" tableName="ps_hook_event_record">
            <column name="status"/>
            <column name="retry_count"/>
            <column name="last_retry_at"/>
            <column name="created_at"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
