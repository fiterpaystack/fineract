<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <changeSet author="paystack" id="004_add_kafka_hook_template">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="m_hook_templates"/>
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM m_hook_templates WHERE name = 'Kafka'
            </sqlCheck>
        </preConditions>
        <comment>Add Kafka hook template and schema fields</comment>
        
        <!-- Add Kafka template to m_hook_templates -->
        <insert tableName="m_hook_templates">
            <column name="name" value="Kafka"/>
        </insert>
        
        <!-- Add Topic Name field to m_hook_schema (required) -->
        <insert tableName="m_hook_schema">
            <column name="hook_template_id" valueComputed="(SELECT id FROM m_hook_templates WHERE name = 'Kafka')"/>
            <column name="field_type" value="string"/>
            <column name="field_name" value="Topic Name"/>
            <column name="placeholder" value="fineract-client-account-events"/>
            <column name="optional" valueBoolean="false"/>
        </insert>
        
        <!-- Add Partition Key Strategy field to m_hook_schema (optional) -->
        <insert tableName="m_hook_schema">
            <column name="hook_template_id" valueComputed="(SELECT id FROM m_hook_templates WHERE name = 'Kafka')"/>
            <column name="field_type" value="string"/>
            <column name="field_name" value="Partition Key Strategy"/>
            <column name="placeholder" value="aggregateRootId / entityId / roundRobin"/>
            <column name="optional" valueBoolean="true"/>
        </insert>
    </changeSet>

</databaseChangeLog>
