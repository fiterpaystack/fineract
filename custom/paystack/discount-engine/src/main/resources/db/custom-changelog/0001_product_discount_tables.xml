<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <changeSet id="paystack-0001-product-discount-tables" author="paystack">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="m_product_discount_rule"/>
            </not>
        </preConditions>
        <comment>Create product discount engine tables</comment>

        <!-- Product Discount Rule table -->
        <createTable tableName="m_product_discount_rule">
            <column name="id" type="bigint(20)" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="product_id" type="bigint(20)" nullable="false">
                <constraints references="m_savings_product(id)" foreignKeyName="FK_product_discount_rule_product_id"/>
            </column>
            <column name="name" type="varchar(100)" nullable="false"/>
            <column name="description" type="varchar(500)"/>
            <column name="discount_type" type="varchar(20)" nullable="false"/>
            <column name="discount_value" type="decimal(19,6)" nullable="false"/>
            <column name="max_discount_amount" type="decimal(19,6)"/>
            <column name="conditions" type="json"/>
            <column name="is_active" type="boolean" default="true"/>
            <column name="priority" type="int" default="0"/>
            <column name="created_date" type="datetime"/>
            <column name="created_by" type="bigint(20)"/>
            <column name="last_modified_date" type="datetime"/>
            <column name="last_modified_by" type="bigint(20)"/>
        </createTable>

        <!-- Discount Application table -->
        <createTable tableName="m_discount_application">
            <column name="id" type="bigint(20)" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="discount_rule_id" type="bigint(20)" nullable="false">
                <constraints references="m_product_discount_rule(id)" foreignKeyName="FK_discount_application_rule_id"/>
            </column>
            <column name="charge_id" type="bigint(20)" nullable="false">
                <constraints references="m_savings_account_charge(id)" foreignKeyName="FK_discount_application_charge_id"/>
            </column>
            <column name="original_amount" type="decimal(19,6)" nullable="false"/>
            <column name="discount_amount" type="decimal(19,6)" nullable="false"/>
            <column name="application_date" type="datetime" nullable="false"/>
        </createTable>

        <!-- Indexes for performance -->
        <createIndex tableName="m_product_discount_rule" indexName="idx_product_discount_rule_product_id">
            <column name="product_id"/>
        </createIndex>

        <createIndex tableName="m_product_discount_rule" indexName="idx_product_discount_rule_active">
            <column name="is_active"/>
        </createIndex>

        <createIndex tableName="m_discount_application" indexName="idx_discount_application_rule_id">
            <column name="discount_rule_id"/>
        </createIndex>

        <createIndex tableName="m_discount_application" indexName="idx_discount_application_charge_id">
            <column name="charge_id"/>
        </createIndex>

    </changeSet>

</databaseChangeLog>