<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <changeSet author="paystack" id="1">
        <createTable tableName="string_columns">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="column_name" type="VARCHAR(100)">
                <constraints nullable="false" unique="true"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet author="paystack" id="2">
        <insert tableName="string_columns">
            <column name="column_name" value="Account No"/>
        </insert>
        <insert tableName="string_columns">
            <column name="column_name" value="Client Account No"/>
        </insert>
        <insert tableName="string_columns">
            <column name="column_name" value="External Id"/>
        </insert>
        <insert tableName="string_columns">
            <column name="column_name" value="CustomerID"/>
        </insert>
        <insert tableName="string_columns">
            <column name="column_name" value="Mobile"/>
        </insert>
        <insert tableName="string_columns">
            <column name="column_name" value="Phone Number"/>
        </insert>
        <insert tableName="string_columns">
            <column name="column_name" value="BVN"/>
        </insert>
        <insert tableName="string_columns">
            <column name="column_name" value="Incorporation No"/>
        </insert>
        <insert tableName="string_columns">
            <column name="column_name" value="Tax ID"/>
        </insert>
        <insert tableName="string_columns">
            <column name="column_name" value="Debit Account"/>
        </insert>
        <insert tableName="string_columns">
            <column name="column_name" value="Credit Account"/>
        </insert>
        <insert tableName="string_columns">
            <column name="column_name" value="ContractID"/>
        </insert>
    </changeSet>

</databaseChangeLog>
