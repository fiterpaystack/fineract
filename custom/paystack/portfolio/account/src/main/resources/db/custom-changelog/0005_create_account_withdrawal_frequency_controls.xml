<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <changeSet id="paystack-account-withdrawal-frequency-0005" author="paystack">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="m_savings_account_withdrawal_frequency_setting"/>
            </not>
        </preConditions>
        <comment>Create account-level withdrawal frequency controls table</comment>

        <!-- Account-level withdrawal frequency settings -->
        <createTable tableName="m_savings_account_withdrawal_frequency_setting">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="savings_account_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="max_withdrawals" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="time_period" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="created_on_utc" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_by" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_on_utc" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- Database-agnostic unique constraints using SQL -->
        <sql dbms="postgresql">
            ALTER TABLE m_savings_account_withdrawal_frequency_setting
            ADD CONSTRAINT uq_sawfs_account_period
            UNIQUE (savings_account_id, time_period);
        </sql>

        <sql dbms="mysql">
            ALTER TABLE m_savings_account_withdrawal_frequency_setting
            ADD CONSTRAINT uq_sawfs_account_period
            UNIQUE (savings_account_id, time_period);
        </sql>

        <sql dbms="h2">
            ALTER TABLE m_savings_account_withdrawal_frequency_setting
            ADD CONSTRAINT uq_sawfs_account_period
            UNIQUE (savings_account_id, time_period);
        </sql>

        <!-- Foreign key constraints -->
        <!-- skip this change as it's causing locks on the server db-->
<!--        <addForeignKeyConstraint baseTableName="m_savings_account_withdrawal_frequency_setting"-->
<!--                                 baseColumnNames="savings_account_id"-->
<!--                                 referencedTableName="m_savings_account"-->
<!--                                 referencedColumnNames="id"-->
<!--                                 constraintName="fk_sawfs_account_id"-->
<!--                                 onDelete="CASCADE"-->
<!--                                 onUpdate="CASCADE"/>-->

        <!-- Audit foreign keys -->
        <addForeignKeyConstraint baseTableName="m_savings_account_withdrawal_frequency_setting"
                                 baseColumnNames="created_by"
                                 referencedTableName="m_appuser"
                                 referencedColumnNames="id"
                                 constraintName="fk_sawfs_created_by"/>

        <addForeignKeyConstraint baseTableName="m_savings_account_withdrawal_frequency_setting"
                                 baseColumnNames="last_modified_by"
                                 referencedTableName="m_appuser"
                                 referencedColumnNames="id"
                                 constraintName="fk_sawfs_modified_by"/>

        <!-- Performance indexes -->
        <createIndex tableName="m_savings_account_withdrawal_frequency_setting" indexName="idx_sawfs_account_id">
            <column name="savings_account_id"/>
        </createIndex>

        <createIndex tableName="m_savings_account_withdrawal_frequency_setting" indexName="idx_sawfs_account_period">
            <column name="savings_account_id"/>
            <column name="time_period"/>
        </createIndex>

        <createIndex tableName="m_savings_account_withdrawal_frequency_setting" indexName="idx_sawfs_active">
            <column name="is_active"/>
        </createIndex>

        <rollback>
            <dropForeignKeyConstraint baseTableName="m_savings_account_withdrawal_frequency_setting"
                                     constraintName="fk_sawfs_modified_by"/>

            <dropForeignKeyConstraint baseTableName="m_savings_account_withdrawal_frequency_setting"
                                     constraintName="fk_sawfs_created_by"/>

            <dropForeignKeyConstraint baseTableName="m_savings_account_withdrawal_frequency_setting"
                                     constraintName="fk_sawfs_account_id"/>

            <dropTable tableName="m_savings_account_withdrawal_frequency_setting"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
