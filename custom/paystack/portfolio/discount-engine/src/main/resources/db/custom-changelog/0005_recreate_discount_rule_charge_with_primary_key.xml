<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">
    <changeSet id="recreate-m_discount_rule_charge-with-pk" author="fineract">
        <comment>Drop and recreate m_discount_rule_charge table with proper primary key</comment>

        <!-- Create a temporary table to store existing data -->
        <createTable tableName="m_discount_rule_charge_temp">
            <column name="discount_rule_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="charge_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="assignment_priority" type="int" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- Copy data from original table to temporary table -->
        <sql>
            INSERT INTO m_discount_rule_charge_temp (discount_rule_id, charge_id, assignment_priority)
            SELECT discount_rule_id, charge_id, assignment_priority FROM m_discount_rule_charge;
        </sql>

        <!-- Drop the original table with all its constraints -->
        <dropTable tableName="m_discount_rule_charge"/>

        <!-- Recreate the table with primary key -->
        <createTable tableName="m_discount_rule_charge">
            <column name="discount_rule_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_m_discount_rule_charge"/>
            </column>
            <column name="charge_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_m_discount_rule_charge"/>
            </column>
            <column name="assignment_priority" type="int" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- Copy data back from temporary table -->
        <sql>
            INSERT INTO m_discount_rule_charge (discount_rule_id, charge_id, assignment_priority)
            SELECT discount_rule_id, charge_id, assignment_priority FROM m_discount_rule_charge_temp;
        </sql>

        <!-- Drop the temporary table -->
        <dropTable tableName="m_discount_rule_charge_temp"/>

        <!-- Recreate indexes -->
        <createIndex tableName="m_discount_rule_charge" indexName="idx_drc_discount_rule_id">
            <column name="discount_rule_id"/>
        </createIndex>

        <createIndex tableName="m_discount_rule_charge" indexName="idx_drc_charge_id">
            <column name="charge_id"/>
        </createIndex>

        <createIndex tableName="m_discount_rule_charge" indexName="idx_drc_priority">
            <column name="charge_id"/>
            <column name="assignment_priority" descending="true"/>
            <column name="discount_rule_id"/>
        </createIndex>

        <!-- Recreate foreign key constraints -->
        <addForeignKeyConstraint baseTableName="m_discount_rule_charge"
                                 baseColumnNames="discount_rule_id"
                                 referencedTableName="m_discount_rule"
                                 referencedColumnNames="id"
                                 constraintName="fk_drc_discount_rule_id"
                                 onDelete="CASCADE" onUpdate="RESTRICT"/>

        <addForeignKeyConstraint baseTableName="m_discount_rule_charge"
                                 baseColumnNames="charge_id"
                                 referencedTableName="m_charge"
                                 referencedColumnNames="id"
                                 constraintName="fk_drc_charge_id"
                                 onDelete="CASCADE" onUpdate="RESTRICT"/>
    </changeSet>
</databaseChangeLog>
